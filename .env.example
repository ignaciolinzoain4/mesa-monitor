# Copiá este archivo a .env y completá los valores. El .env NUNCA se sube al repo.

# Perfil de Docker Compose: "cpu" o "gpu" (gpu necesita placa NVIDIA + NVIDIA Container Toolkit)
COMPOSE_PROFILES=cpu

# --- Base de datos ---
POSTGRES_USER=mesa
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=mesa_monitor
# Usá solo letras, números, "-" y "_" en la contraseña (va dentro de una URL).
# Docker Compose arma DATABASE_URL solo. Esta línea sirve para correr la API fuera de Docker:
# DATABASE_URL=postgresql+asyncpg://mesa:cambiame@localhost:5432/mesa_monitor

# --- Seguridad ---
# OBLIGATORIO: la API no arranca con este valor de ejemplo. Generá uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=reemplazar-por-un-valor-largo-y-aleatorio
# Usuario administrador que se crea al primer arranque
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiame

# --- NVR Dahua ---
NVR_HOST=192.0.2.10
NVR_PORT=554
NVR_USER=usuario
NVR_PASSWORD=clave

# --- General ---
TIMEZONE=America/Argentina/Cordoba
LOG_LEVEL=INFO
# Orígenes permitidos para CORS (separados por coma). Vacío = solo mismo origen.
CORS_ORIGINS=
# Puerto donde se publica la API + dashboard en la PC
API_PORT=8000
