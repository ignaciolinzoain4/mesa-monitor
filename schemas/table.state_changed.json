{
  "$defs": {
    "TableRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "sector": {
          "title": "Sector",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "sector"
      ],
      "title": "TableRef",
      "type": "object"
    },
    "TableState": {
      "enum": [
        "LIBRE",
        "OCUPADA_SIN_ATENDER",
        "ATENDIDA",
        "CONSUMIENDO",
        "DESOCUPADA_SUCIA",
        "SIN_VISION",
        "DESHABILITADA"
      ],
      "title": "TableState",
      "type": "string"
    },
    "TableStateData": {
      "description": "Estado vigente de una mesa (snapshot y `table.state_changed`).",
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Segundos en el estado actual, descontando el tiempo sin visión",
          "title": "Elapsed Seconds"
        },
        "first_attention_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Attention At"
        },
        "last_visit_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Visit At"
        },
        "partial": {
          "default": false,
          "description": "La sesión empezó antes de que el sistema mirara (sin tiempo de espera)",
          "title": "Partial",
          "type": "boolean"
        },
        "people": {
          "default": 0,
          "title": "People",
          "type": "integer"
        },
        "previous_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "seated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seated At"
        },
        "served_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comida o bebida detectada en la mesa (paso a CONSUMIENDO)",
          "title": "Served At"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "state": {
          "$ref": "#/$defs/TableState"
        },
        "state_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Since"
        },
        "table": {
          "$ref": "#/$defs/TableRef"
        },
        "vacated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vacated At"
        }
      },
      "required": [
        "table",
        "state",
        "state_since"
      ],
      "title": "TableStateData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/TableStateData"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "table.state_changed",
      "default": "table.state_changed",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "ts",
    "data"
  ],
  "title": "TableStateChangedEvent",
  "type": "object"
}
