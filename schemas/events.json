{
  "$defs": {
    "AlertData": {
      "properties": {
        "acknowledged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged At"
        },
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "alert_type": {
          "$ref": "#/$defs/AlertType"
        },
        "camera_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "snoozed_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snoozed Until"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Since"
        },
        "status": {
          "$ref": "#/$defs/AlertStatus"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "threshold_seconds": {
          "title": "Threshold Seconds",
          "type": "number"
        }
      },
      "required": [
        "alert_id",
        "alert_type",
        "severity",
        "status",
        "threshold_seconds",
        "opened_at"
      ],
      "title": "AlertData",
      "type": "object"
    },
    "AlertOpenedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/AlertData"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "alert.opened",
          "default": "alert.opened",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "data"
      ],
      "title": "AlertOpenedEvent",
      "type": "object"
    },
    "AlertResolvedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/AlertData"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "alert.resolved",
          "default": "alert.resolved",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "data"
      ],
      "title": "AlertResolvedEvent",
      "type": "object"
    },
    "AlertStatus": {
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "AlertType": {
      "enum": [
        "SIN_ATENCION",
        "SIN_VISITA",
        "MESA_SUCIA",
        "ESTADIA_LARGA",
        "CAMARA_CAIDA"
      ],
      "title": "AlertType",
      "type": "string"
    },
    "AlertUpdatedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/AlertData"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "alert.updated",
          "default": "alert.updated",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "data"
      ],
      "title": "AlertUpdatedEvent",
      "type": "object"
    },
    "CameraStatus": {
      "enum": [
        "online",
        "degraded",
        "offline"
      ],
      "title": "CameraStatus",
      "type": "string"
    },
    "CameraStatusData": {
      "properties": {
        "camera_id": {
          "title": "Camera Id",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CameraStatus"
        }
      },
      "required": [
        "camera_id",
        "name",
        "status"
      ],
      "title": "CameraStatusData",
      "type": "object"
    },
    "CameraStatusEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/CameraStatusData"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "camera.status",
          "default": "camera.status",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "data"
      ],
      "title": "CameraStatusEvent",
      "type": "object"
    },
    "HeartbeatEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Data",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "heartbeat",
          "default": "heartbeat",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts"
      ],
      "title": "HeartbeatEvent",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SnapshotData": {
      "properties": {
        "alerts": {
          "items": {
            "$ref": "#/$defs/AlertData"
          },
          "title": "Alerts",
          "type": "array"
        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/CameraStatusData"
          },
          "title": "Cameras",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/TableStateData"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "tables",
        "alerts",
        "cameras"
      ],
      "title": "SnapshotData",
      "type": "object"
    },
    "SnapshotEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/SnapshotData"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "snapshot",
          "default": "snapshot",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "data"
      ],
      "title": "SnapshotEvent",
      "type": "object"
    },
    "StaffVisitData": {
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "table": {
          "$ref": "#/$defs/TableRef"
        },
        "visit_id": {
          "title": "Visit Id",
          "type": "string"
        }
      },
      "required": [
        "table",
        "session_id",
        "visit_id",
        "started_at"
      ],
      "title": "StaffVisitData",
      "type": "object"
    },
    "TableRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "sector": {
          "title": "Sector",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "sector"
      ],
      "title": "TableRef",
      "type": "object"
    },
    "TableStaffVisitEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/StaffVisitData"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "table.staff_visit",
          "default": "table.staff_visit",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "data"
      ],
      "title": "TableStaffVisitEvent",
      "type": "object"
    },
    "TableState": {
      "enum": [
        "LIBRE",
        "OCUPADA_SIN_ATENDER",
        "ATENDIDA",
        "DESOCUPADA_SUCIA",
        "SIN_VISION",
        "DESHABILITADA"
      ],
      "title": "TableState",
      "type": "string"
    },
    "TableStateChangedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/TableStateData"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "table.state_changed",
          "default": "table.state_changed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ts",
        "data"
      ],
      "title": "TableStateChangedEvent",
      "type": "object"
    },
    "TableStateData": {
      "description": "Estado vigente de una mesa (snapshot y `table.state_changed`).",
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Segundos en el estado actual, descontando el tiempo sin visión",
          "title": "Elapsed Seconds"
        },
        "first_attention_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Attention At"
        },
        "last_visit_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Visit At"
        },
        "people": {
          "default": 0,
          "title": "People",
          "type": "integer"
        },
        "previous_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "seated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seated At"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "state": {
          "$ref": "#/$defs/TableState"
        },
        "state_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Since"
        },
        "table": {
          "$ref": "#/$defs/TableRef"
        },
        "vacated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vacated At"
        }
      },
      "required": [
        "table",
        "state",
        "state_since"
      ],
      "title": "TableStateData",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "alert.opened": "#/$defs/AlertOpenedEvent",
      "alert.resolved": "#/$defs/AlertResolvedEvent",
      "alert.updated": "#/$defs/AlertUpdatedEvent",
      "camera.status": "#/$defs/CameraStatusEvent",
      "heartbeat": "#/$defs/HeartbeatEvent",
      "snapshot": "#/$defs/SnapshotEvent",
      "table.staff_visit": "#/$defs/TableStaffVisitEvent",
      "table.state_changed": "#/$defs/TableStateChangedEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SnapshotEvent"
    },
    {
      "$ref": "#/$defs/TableStateChangedEvent"
    },
    {
      "$ref": "#/$defs/TableStaffVisitEvent"
    },
    {
      "$ref": "#/$defs/AlertOpenedEvent"
    },
    {
      "$ref": "#/$defs/AlertUpdatedEvent"
    },
    {
      "$ref": "#/$defs/AlertResolvedEvent"
    },
    {
      "$ref": "#/$defs/CameraStatusEvent"
    },
    {
      "$ref": "#/$defs/HeartbeatEvent"
    }
  ]
}
