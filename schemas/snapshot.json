{
  "$defs": {
    "AlertData": {
      "properties": {
        "acknowledged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged At"
        },
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "alert_type": {
          "$ref": "#/$defs/AlertType"
        },
        "camera_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "snoozed_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snoozed Until"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Since"
        },
        "status": {
          "$ref": "#/$defs/AlertStatus"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "threshold_seconds": {
          "title": "Threshold Seconds",
          "type": "number"
        }
      },
      "required": [
        "alert_id",
        "alert_type",
        "severity",
        "status",
        "threshold_seconds",
        "opened_at"
      ],
      "title": "AlertData",
      "type": "object"
    },
    "AlertStatus": {
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "AlertType": {
      "enum": [
        "SIN_ATENCION",
        "SIN_VISITA",
        "MESA_SUCIA",
        "ESTADIA_LARGA",
        "CAMARA_CAIDA"
      ],
      "title": "AlertType",
      "type": "string"
    },
    "CameraStatus": {
      "enum": [
        "online",
        "degraded",
        "offline"
      ],
      "title": "CameraStatus",
      "type": "string"
    },
    "CameraStatusData": {
      "properties": {
        "camera_id": {
          "title": "Camera Id",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CameraStatus"
        }
      },
      "required": [
        "camera_id",
        "name",
        "status"
      ],
      "title": "CameraStatusData",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SnapshotData": {
      "properties": {
        "alerts": {
          "items": {
            "$ref": "#/$defs/AlertData"
          },
          "title": "Alerts",
          "type": "array"
        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/CameraStatusData"
          },
          "title": "Cameras",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/TableStateData"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "tables",
        "alerts",
        "cameras"
      ],
      "title": "SnapshotData",
      "type": "object"
    },
    "TableRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "sector": {
          "title": "Sector",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "sector"
      ],
      "title": "TableRef",
      "type": "object"
    },
    "TableState": {
      "enum": [
        "LIBRE",
        "OCUPADA_SIN_ATENDER",
        "ATENDIDA",
        "CONSUMIENDO",
        "DESOCUPADA_SUCIA",
        "SIN_VISION",
        "DESHABILITADA"
      ],
      "title": "TableState",
      "type": "string"
    },
    "TableStateData": {
      "description": "Estado vigente de una mesa (snapshot y `table.state_changed`).",
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Segundos en el estado actual, descontando el tiempo sin visión",
          "title": "Elapsed Seconds"
        },
        "first_attention_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Attention At"
        },
        "last_visit_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Visit At"
        },
        "partial": {
          "default": false,
          "description": "La sesión empezó antes de que el sistema mirara (sin tiempo de espera)",
          "title": "Partial",
          "type": "boolean"
        },
        "people": {
          "default": 0,
          "title": "People",
          "type": "integer"
        },
        "previous_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "seated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seated At"
        },
        "served_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comida o bebida detectada en la mesa (paso a CONSUMIENDO)",
          "title": "Served At"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "state": {
          "$ref": "#/$defs/TableState"
        },
        "state_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Since"
        },
        "table": {
          "$ref": "#/$defs/TableRef"
        },
        "vacated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vacated At"
        }
      },
      "required": [
        "table",
        "state",
        "state_since"
      ],
      "title": "TableStateData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/SnapshotData"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "const": "snapshot",
      "default": "snapshot",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "ts",
    "data"
  ],
  "title": "SnapshotEvent",
  "type": "object"
}
